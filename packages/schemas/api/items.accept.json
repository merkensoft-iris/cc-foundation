              "description": "ID with the prefix run_ (03 §3)"
            },
            "verdict": { "type": "string", "enum": ["consistent", "inconsistent", "unclear"] },
            "notes": { "type": "string" }
          },
          "required": ["runId", "verdict", "notes"],
          "additionalProperties": false
        },
        "decidedBy": { "$ref": "#/$defs/Actor" },
        "decidedAt": { "$ref": "#/$defs/UtcTimestamp" },
        "attestationNote": { "type": "string" },
        "rejectedClaims": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "at": { "$ref": "#/$defs/UtcTimestamp" },
              "by": { "$ref": "#/$defs/Actor" },
              "reason": { "type": "string", "minLength": 1 }
            },
            "required": ["at", "by", "reason"],
            "additionalProperties": false
          }
        }
      },
      "required": ["checks", "rejectedClaims"],
      "additionalProperties": false,
      "description": "How a claimed item was verified, or why its claims were rejected (03 §5.9)"
    },
    "CheckResult": {
      "type": "object",
      "properties": {
        "requirementId": { "type": "string", "minLength": 1 },
        "status": { "type": "string", "enum": ["pass", "fail", "inconclusive", "pending"] },
        "at": { "$ref": "#/$defs/UtcTimestamp" },
        "detail": { "type": "string" },
        "runId": {
          "type": "string",
          "pattern": "^run_[A-Za-z0-9_]+$",
          "description": "ID with the prefix run_ (03 §3)"
        },
        "evidenceId": {
          "type": "string",
          "pattern": "^evd_[A-Za-z0-9_]+$",
          "description": "ID with the prefix evd_ (03 §3)"
        }
      },
      "required": ["requirementId", "status", "at", "detail"],
      "additionalProperties": false,
      "description": "The outcome of one verification check (03 §5.9)"
    },
    "ExternalRef": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "system": { "type": "string", "const": "firstmate" },
            "home": { "type": "string", "minLength": 1 },
            "taskId": { "type": "string", "minLength": 1 }
          },
          "required": ["system", "home", "taskId"],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "system": { "type": "string", "const": "github" },
            "url": { "type": "string", "format": "uri" }
          },
          "required": ["system", "url"],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "system": { "type": "string", "const": "calendar" },
            "bindingId": {
              "type": "string",
              "pattern": "^bnd_[A-Za-z0-9_]+$",
              "description": "ID with the prefix bnd_ (03 §3)"
            },
            "eventId": { "type": "string", "minLength": 1 }
          },
          "required": ["system", "bindingId", "eventId"],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "system": { "type": "string", "const": "other" },
            "label": { "type": "string", "minLength": 1 },
            "url": { "type": "string", "format": "uri" }
          },
          "required": ["system", "label"],
          "additionalProperties": false
        }
      ],
      "description": "A pointer to the item in another system (03 §5.7)"
    }
  }
}

            "name": {
              "type": "string",
              "pattern": "^[a-z0-9][a-z0-9-]*$",
              "description": "Principal name, also the token file name"
            },
            "kind": {
              "type": "string",
              "enum": ["cli", "mcp_client", "external_framework", "internal_orchestrator"]
            },
            "scopes": {
              "type": "array",
              "items": {
                "type": "string",
                "enum": [
                  "read",
                  "items:write",
                  "items:claim",
                  "decisions:propose",
                  "meetings:capture",
                  "measures:write",
                  "connectors:read",
                  "connectors:invoke",
                  "sessions:read",
                  "discovery:request",
                  "requests:propose",
                  "onboarding:apply"

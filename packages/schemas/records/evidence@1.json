{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$comment": "Generated by pnpm cc:gen from packages/schemas/src/records/evidence.ts (03 §5.9). Do not edit by hand: change the source and run pnpm cc:gen.",
  "title": "evidence@1",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^evd_[A-Za-z0-9_]+$",
      "description": "ID with the prefix evd_ (03 §3)"
    },
    "actionItemId": {
      "type": "string",
      "pattern": "^act_[A-Za-z0-9_]+$",
      "description": "ID with the prefix act_ (03 §3)"
    },
    "requirementId": { "type": "string", "minLength": 1 },
    "kind": {
      "type": "string",
      "enum": [
        "url",
        "file",
        "note",
        "connector_record",
        "measure_value",
        "meeting_record",
        "external_task"
      ]
    },
    "summary": { "type": "string", "minLength": 1, "maxLength": 200 },
    "url": { "type": "string", "format": "uri" },
    "blobSha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$",
      "description": "SHA-256, lower-case hex"
    },
    "record": {
      "type": "object",
      "properties": {
        "bindingId": {
          "type": "string",
          "pattern": "^bnd_[A-Za-z0-9_]+$",
          "description": "ID with the prefix bnd_ (03 §3)"
        },
        "recordType": { "type": "string", "minLength": 1 },
        "externalId": { "type": "string", "minLength": 1 }
      },
      "required": ["bindingId", "recordType", "externalId"],
      "additionalProperties": false
    },
    "externalTask": {
      "type": "object",
      "properties": {
        "system": { "type": "string", "const": "firstmate" },
        "home": { "type": "string", "minLength": 1 },
        "taskId": { "type": "string", "minLength": 1 },
        "pr": { "type": "string", "minLength": 1 }
      },
      "required": ["system", "home", "taskId"],
      "additionalProperties": false
    },
    "capturedAt": { "$ref": "#/$defs/UtcTimestamp" },
    "capturedBy": { "$ref": "#/$defs/Actor" }
  },
  "required": ["id", "actionItemId", "kind", "summary", "capturedAt", "capturedBy"],
  "additionalProperties": false,
  "description": "Evidence (03 §5.9): something that shows an action item was done",
  "$defs": {
    "UtcTimestamp": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$",
      "description": "RFC 3339 timestamp in UTC"
    },
    "Actor": {
      "oneOf": [
        {
          "type": "object",
          "properties": { "kind": { "type": "string", "const": "user" } },
          "required": ["kind"],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": { "type": "string", "const": "agent" },
            "principalId": {
              "type": "string",
              "pattern": "^agt_[A-Za-z0-9_]+$",
              "description": "ID with the prefix agt_ (03 §3)"
            },
            "runId": {
              "type": "string",
              "pattern": "^run_[A-Za-z0-9_]+$",
              "description": "ID with the prefix run_ (03 §3)"
            }
          },
          "required": ["kind", "principalId"],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": { "type": "string", "const": "connector" },
            "bindingId": {
              "type": "string",
              "pattern": "^bnd_[A-Za-z0-9_]+$",
              "description": "ID with the prefix bnd_ (03 §3)"
            },
            "runId": {
              "type": "string",
              "pattern": "^run_[A-Za-z0-9_]+$",
              "description": "ID with the prefix run_ (03 §3)"
            }
          },
          "required": ["kind", "bindingId", "runId"],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": { "type": "string", "const": "system" },
            "component": {
              "type": "string",
              "enum": ["rhythm", "review", "escalation", "ingest", "scheduler", "migration"]
            }
          },
          "required": ["kind", "component"],
          "additionalProperties": false
        }
      ],
      "description": "Who did something: the user, an agent principal, a connector run or a system component"
    }
  }
}

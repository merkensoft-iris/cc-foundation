{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$comment": "Generated by pnpm cc:gen from packages/schemas/src/records/person.ts (03 §5.1). Do not edit by hand: change the source and run pnpm cc:gen.",
  "title": "person@1",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^per_[A-Za-z0-9_]+$",
      "description": "ID with the prefix per_ (03 §3)"
    },
    "displayName": { "type": "string", "minLength": 1 },
    "role": { "type": "string", "enum": ["self", "collaborator", "external"] },
    "emails": {
      "type": "array",
      "items": {
        "type": "string",
        "format": "email",
        "pattern": "^(?:[A-Za-z0-9_'+\\-]+\\.)*[A-Za-z0-9_'+\\-]*[A-Za-z0-9_+-]@(?:[A-Za-z0-9][A-Za-z0-9\\-]*\\.)+[A-Za-z]{2,}$"
      }
    },
    "timeZone": {
      "type": "string",
      "pattern": "^[A-Za-z][A-Za-z0-9_+-]*(?:\\/[A-Za-z0-9_+-]+)*$",
      "description": "IANA time zone name"
    },
    "consents": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "scope": {
            "anyOf": [
              {
                "type": "string",
                "enum": [
                  "track_my_search",
                  "draft_on_my_behalf",
                  "read_my_alert_mailbox",
                  "contact_me"
                ]
              },
              { "type": "string", "minLength": 1 }
            ]
          },
          "grantedAt": { "$ref": "#/$defs/UtcTimestamp" },
          "recordedBy": { "$ref": "#/$defs/Actor" },
          "evidenceNote": { "type": "string", "minLength": 1 },
          "revokedAt": { "$ref": "#/$defs/UtcTimestamp" }
        },
        "required": ["scope", "grantedAt", "recordedBy", "evidenceNote"],
        "additionalProperties": false,
        "description": "What a person agreed the user may do on their behalf (03 §5.1)"
      }
    },
    "createdAt": { "$ref": "#/$defs/UtcTimestamp" },
    "createdBy": { "$ref": "#/$defs/Actor" },
    "updatedAt": { "$ref": "#/$defs/UtcTimestamp" },
    "updatedBy": { "$ref": "#/$defs/Actor" },
    "version": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 }
  },
  "required": [
    "id",
    "displayName",
    "role",
    "emails",
    "consents",
    "createdAt",
    "createdBy",
    "updatedAt",
    "updatedBy",
    "version"
  ],
  "additionalProperties": false,
  "description": "Person (03 §5.1): the user or someone the user works with; never a CC user",
  "$defs": {
    "UtcTimestamp": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$",
      "description": "RFC 3339 timestamp in UTC"
    },
    "Actor": {
      "oneOf": [
        {
          "type": "object",
          "properties": { "kind": { "type": "string", "const": "user" } },
          "required": ["kind"],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": { "type": "string", "const": "agent" },
            "principalId": {
              "type": "string",
              "pattern": "^agt_[A-Za-z0-9_]+$",
              "description": "ID with the prefix agt_ (03 §3)"
            },
            "runId": {
              "type": "string",
              "pattern": "^run_[A-Za-z0-9_]+$",
              "description": "ID with the prefix run_ (03 §3)"
            }
          },
          "required": ["kind", "principalId"],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": { "type": "string", "const": "connector" },
            "bindingId": {
              "type": "string",
              "pattern": "^bnd_[A-Za-z0-9_]+$",
              "description": "ID with the prefix bnd_ (03 §3)"
            },
            "runId": {
              "type": "string",
              "pattern": "^run_[A-Za-z0-9_]+$",
              "description": "ID with the prefix run_ (03 §3)"
            }
          },
          "required": ["kind", "bindingId", "runId"],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": { "type": "string", "const": "system" },
            "component": {
              "type": "string",
              "enum": ["rhythm", "review", "escalation", "ingest", "scheduler", "migration"]
            }
          },
          "required": ["kind", "component"],
          "additionalProperties": false
        }
      ],
      "description": "Who did something: the user, an agent principal, a connector run or a system component"
    }
  }
}

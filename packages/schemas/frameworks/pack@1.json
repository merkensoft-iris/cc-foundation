{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$comment": "Generated by pnpm cc:gen from packages/schemas/src/frameworks/framework.ts (01 §4, §5.5). Do not edit by hand: change the source and run pnpm cc:gen.",
  "title": "pack@1",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^pack\\.[a-z0-9]+(?:-[a-z0-9]+)*$",
      "description": "A pack ID such as pack.marketing (01 §5.5)"
    },
    "version": {
      "type": "string",
      "pattern": "^(?:0|[1-9]\\d*)\\.(?:0|[1-9]\\d*)\\.(?:0|[1-9]\\d*)$",
      "description": "Semantic version MAJOR.MINOR.PATCH"
    },
    "title": { "type": "string", "minLength": 1 },
    "measureTemplates": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "key": { "type": "string", "pattern": "^[a-z][a-z0-9_-]*$" },
          "name": { "type": "string", "minLength": 1 },
          "unit": {
            "type": "string",
            "enum": ["count", "percent", "currency", "hours", "boolean", "days"]
          },
          "role": { "type": "string", "enum": ["lead", "lag"] },
          "cadence": {
            "type": "string",
            "enum": ["daily", "weekly", "biweekly", "monthly", "quarterly", "yearly"]
          },
          "defaultTarget": {
            "type": "object",
            "properties": {
              "op": { "type": "string", "enum": ["gte", "lte", "eq"] },
              "value": { "type": "number" }
            },
            "required": ["op", "value"],
            "additionalProperties": false
          }
        },
        "required": ["key", "name", "unit", "role", "cadence"],
        "additionalProperties": false
      }
    },
    "agendaSections": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "slot": { "type": "string", "minLength": 1 },
          "sectionTemplateId": { "type": "string", "minLength": 1 }
        },
        "required": ["slot", "sectionTemplateId"],
        "additionalProperties": false
      }
    },
    "actionTemplates": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "title": { "type": "string", "minLength": 1 },
          "kind": { "type": "string", "enum": ["todo", "follow_up"] },
          "doneMeans": { "type": "string", "minLength": 1 },
          "evidenceRequirements": {
            "type": "array",
            "items": { "$ref": "#/$defs/EvidenceRequirement" }
          },
          "verificationPolicy": {
            "type": "string",
            "enum": ["require_review", "auto_close_on_checks"]
          },
          "steps": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": { "type": "string", "minLength": 1 },
                "order": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 },
                "title": { "type": "string", "minLength": 1 },
                "performer": { "$ref": "#/$defs/Performer" },
                "dependsOn": { "type": "array", "items": { "type": "string", "minLength": 1 } },
                "satisfies": { "type": "array", "items": { "type": "string", "minLength": 1 } },
                "confirmation": { "type": "string", "enum": ["policy", "always"] }
              },
              "required": [
                "id",
                "order",
                "title",
                "performer",
                "dependsOn",
                "satisfies",
                "confirmation"
              ],
              "additionalProperties": false
            }
          },
          "bindingRoles": {
            "type": "object",
            "propertyNames": { "type": "string" },
            "additionalProperties": {
              "type": "object",
              "properties": {
                "category": { "type": "string", "minLength": 1 },
                "connectorIds": { "type": "array", "items": { "type": "string", "minLength": 1 } }
              },
              "required": ["category", "connectorIds"],
              "additionalProperties": false
            }
          },
          "defaultDueOffsetDays": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 }
        },
        "required": [
          "id",
          "title",
          "kind",
          "doneMeans",
          "evidenceRequirements",
          "verificationPolicy",
          "steps",
          "bindingRoles",
          "defaultDueOffsetDays"
        ],
        "additionalProperties": false,
        "description": "ActionTemplate (03 §8.4): a reusable action item definition in a pack"
      }
    },
    "recurringItems": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "templateId": { "type": "string", "minLength": 1 },
          "rrule": { "type": "string", "minLength": 1 },
          "timeZone": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9_+-]*(?:\\/[A-Za-z0-9_+-]+)*$",
            "description": "IANA time zone name"
          }
        },
        "required": ["templateId", "rrule"],
        "additionalProperties": false
      }
    },
    "connectorSuggestions": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "category": {
            "type": "string",
            "enum": [
              "calendar",
              "email",
              "chat",
              "social",
              "social_scheduler",
              "cms",
              "crm",
              "hosting",
              "code",
              "docs",
              "time_tracking",
              "analytics",
              "job_board",
              "accounting",
              "task_tracker",
              "other"
            ]
          },
          "connectorIds": { "type": "array", "items": { "type": "string", "minLength": 1 } }
        },
        "required": ["category", "connectorIds"],
        "additionalProperties": false
      }
    },
    "rules": { "type": "array", "items": { "type": "string", "minLength": 1 } }
  },
  "required": [
    "id",
    "version",
    "title",
    "measureTemplates",
    "agendaSections",
    "actionTemplates",
    "recurringItems",
    "connectorSuggestions",
    "rules"
  ],
  "additionalProperties": false,
  "description": "Pack (01 §4, §5.5): domain content added to a framework instance",
  "$defs": {
    "EvidenceRequirement": {
      "type": "object",
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "description": { "type": "string", "minLength": 1 },
        "required": { "type": "boolean" },
        "acceptedKinds": {
          "minItems": 1,
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "url",
              "file",
              "note",
              "connector_record",
              "measure_value",
              "meeting_record",
              "external_task"
            ]
          }
        },
        "check": { "$ref": "#/$defs/VerificationCheck" }
      },
      "required": ["id", "description", "required", "acceptedKinds"],
      "additionalProperties": false,
      "description": "What must be shown for an item (03 §5.9)"
    },
    "VerificationCheck": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "type": { "type": "string", "const": "connector_query" },
            "bindingId": {
              "type": "string",
              "pattern": "^bnd_[A-Za-z0-9_]+$",
              "description": "ID with the prefix bnd_ (03 §3)"
            },
            "action": { "type": "string", "minLength": 1 },
            "input": {
              "type": "object",
              "propertyNames": { "type": "string" },
              "additionalProperties": {}
            },
            "expect": { "$ref": "#/$defs/Predicate" },
            "notBefore": { "$ref": "#/$defs/UtcTimestamp" },
            "retry": {
              "type": "object",
              "properties": {
                "attempts": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 },
                "intervalMinutes": { "type": "number", "exclusiveMinimum": 0 }
              },
              "required": ["attempts", "intervalMinutes"],
              "additionalProperties": false
            }
          },
          "required": ["type", "bindingId", "action", "input", "expect", "retry"],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "type": { "type": "string", "const": "url_reachable" },
            "url": { "type": "string", "format": "uri" },
            "expectStatus": {
              "minItems": 1,
              "type": "array",
              "items": { "type": "integer", "minimum": 100, "maximum": 599 }
            },
            "expectText": { "type": "string" }
          },
          "required": ["type", "url", "expectStatus"],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "type": { "type": "string", "const": "measure_threshold" },
            "measureId": {
              "type": "string",
              "pattern": "^msr_[A-Za-z0-9_]+$",
              "description": "ID with the prefix msr_ (03 §3)"
            },
            "periodStart": { "$ref": "#/$defs/LocalDate" },
            "expect": { "$ref": "#/$defs/Predicate" }
          },
          "required": ["type", "measureId", "periodStart", "expect"],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "type": { "type": "string", "const": "external_task_state" },
            "system": { "type": "string", "const": "firstmate" },
            "taskId": { "type": "string", "minLength": 1 },
            "expect": { "type": "string", "enum": ["pr_ready", "merged"] }
          },
          "required": ["type", "system", "taskId", "expect"],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "type": { "type": "string", "const": "child_items" },
            "expect": { "type": "string", "const": "all_verified" }
          },
          "required": ["type", "expect"],
          "additionalProperties": false
        }
      ],
      "description": "A deterministic check that can pass an evidence requirement (03 §5.9)"
    },
    "Predicate": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "path": { "type": "string", "minLength": 1 },
            "op": {
              "type": "string",
              "enum": ["eq", "neq", "gt", "gte", "lt", "lte", "contains", "matches", "exists"]
            },
            "value": {}
          },
          "required": ["path", "op"],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "all": { "minItems": 1, "type": "array", "items": { "$ref": "#/$defs/Predicate" } }
          },
          "required": ["all"],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "any": { "minItems": 1, "type": "array", "items": { "$ref": "#/$defs/Predicate" } }
          },
          "required": ["any"],
          "additionalProperties": false
        }
      ],
      "description": "A test on a JSON value: a comparison at a dot path, or all/any of predicates"
    },
    "UtcTimestamp": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$",
      "description": "RFC 3339 timestamp in UTC"
    },
    "LocalDate": {
      "type": "string",
      "format": "date",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))$",
      "description": "Local date YYYY-MM-DD, read in the owning workstream's time zone"
    },
    "Performer": {
      "oneOf": [
        {
          "type": "object",
          "properties": { "kind": { "type": "string", "const": "user" } },
          "required": ["kind"],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": { "type": "string", "const": "person" },
            "personId": {
              "type": "string",
              "pattern": "^per_[A-Za-z0-9_]+$",
              "description": "ID with the prefix per_ (03 §3)"
            }
          },
          "required": ["kind", "personId"],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": { "type": "string", "const": "connector" },
            "bindingId": {
              "type": "string",
              "pattern": "^bnd_[A-Za-z0-9_]+$",
              "description": "ID with the prefix bnd_ (03 §3)"
            },
            "action": { "type": "string", "minLength": 1 },
            "input": {
              "type": "object",
              "propertyNames": { "type": "string" },
              "additionalProperties": {}
            }
          },
          "required": ["kind", "bindingId", "action", "input"],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": { "type": "string", "const": "agent" },
            "profile": {
              "type": "string",
              "enum": [
                "drafter",
                "extractor",
                "planner",
                "reviewer",
                "summarize",
                "tailor",
                "discoverer"
              ]
            },
            "instructions": { "type": "string", "minLength": 1 },
            "tools": { "type": "array", "items": { "type": "string", "minLength": 1 } },
            "budget": {
              "type": "object",
              "properties": {
                "maxUsd": { "type": "number", "minimum": 0 },
                "maxMinutes": { "type": "number", "exclusiveMinimum": 0 },
                "maxToolCalls": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 }
              },
              "required": ["maxUsd", "maxMinutes", "maxToolCalls"],
              "additionalProperties": false
            }
          },
          "required": ["kind", "profile", "instructions", "tools", "budget"],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": { "type": "string", "const": "external_agent" },
            "system": { "type": "string", "enum": ["firstmate", "grok", "other"] },
            "principalId": {
              "type": "string",
              "pattern": "^agt_[A-Za-z0-9_]+$",
              "description": "ID with the prefix agt_ (03 §3)"
            },
            "handoff": { "type": "string", "minLength": 1 }
          },
          "required": ["kind", "system", "handoff"],
          "additionalProperties": false
        }
      ],
      "description": "Who performs an execution step (03 §5.8, §8.1)"
    }
  }
}

{
  "name": "@cc/core",
  "version": "0.0.0",
  "private": true,
  "description": "Core service: local API server, schedulers, Connector Host supervisor, headless mode",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./client": {
      "types": "./dist/client.d.ts",
      "default": "./dist/client.js"
    },
    "./headless": {
      "types": "./dist/headless.d.ts",
      "default": "./dist/headless.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@cc/domain": "workspace:*",
    "@cc/frameworks": "workspace:*",
    "@cc/rhythm": "workspace:*",
    "@cc/schemas": "workspace:*",
    "@cc/store": "workspace:*",
    "zod": "^4.6.7"
  }
}
